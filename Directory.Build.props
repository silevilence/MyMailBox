<Project>
  <Import Project="$(MSBuildThisFileDirectory)Directory.Build.local.props" Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.local.props') and '$(MyMailBoxGraphClientId)' == '' and '$(MYMAILBOX_GRAPH_CLIENT_ID)' == ''" />
  <PropertyGroup>
    <MyMailBoxGraphClientId Condition="'$(MyMailBoxGraphClientId)' == ''">$(MYMAILBOX_GRAPH_CLIENT_ID)</MyMailBoxGraphClientId>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.1.0</Version>
    <PublishAot>false</PublishAot>
    <PublishTrimmed>false</PublishTrimmed>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
</Project>
